# The database: MongoDB, run as a replica set (one node is enough; transactions need it).
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=hrms
# Only for `hrms import-pg` (copying an old PostgreSQL installation): the default -from.
DATABASE_URL=postgres://hrms:hrms@localhost:5433/hrms
PORT=8080
# Development only: the OTP is returned in the API response instead of being sent by SMS.
OTP_DEV_ECHO=true
STORAGE_DIR=data/uploads
# Business time zone: "today", the open month and every time shown come from it, whatever the server's own zone.
APP_TZ=Asia/Kolkata
# Google Drive for uploaded documents (README: one-time setup). The OAuth client of type Web application:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only if the redirect URI cannot be worked out from where the app is opened (e.g. behind a proxy):
# GOOGLE_REDIRECT_URL=https://hr.example.com/api/drive/callback
# Encrypts the stored Google sign-in. Unset: a random key is kept in data/hrms-secret.key (next to STORAGE_DIR).
# APP_SECRET=
# The company mailbox for the new joiner's link and code (Onboarding › Joining details › Joiner's link).
# Leave SMTP_HOST empty and nothing is emailed: HR uses Copy link / Share on WhatsApp and gives the code by phone.
# With OTP_DEV_ECHO=true and no SMTP_HOST, emails are written to the server log instead (development).
# SMTP_HOST=smtp.gmail.com
# Port 587 uses STARTTLS; 465 uses TLS from the start.
# SMTP_PORT=587
# SMTP_USER=hr@example.com
# An app password for the mailbox (not a person's own password). Keep it out of version control.
# SMTP_PASS=
# SMTP_FROM=Saltstayz HR <hr@example.com>
# The web address people open the app at, used in the links that are emailed (default http://localhost:5173).
# APP_URL=https://hr.example.com
# The proxies in front of the API (the web server that serves the app and passes /api on), as addresses or CIDR
# ranges, comma-separated. Their X-Forwarded-For header names the caller for the joiner page's rate limits, so one
# person cannot use up every joiner's limit. Default: the machine itself (127.0.0.1, ::1). "none" trusts no proxy.
# The proxy must set X-Forwarded-For (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
# TRUSTED_PROXIES=10.0.0.5
